{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "cloudflare": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/dist/mcp-server.js"],
      "env": {
        "PI_CLOUDFLARE_PLUGIN_ROOT": "${PLUGIN_ROOT}",
        "PI_CLOUDFLARE_TOKEN_FILE": "${PLUGIN_DATA}/cloudflare-tokens.json"
      },
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
